# Configure a provisioned MySQL database for hosting. This file has no credentials.
# The setup command creates a separate ignored .env automatically.
SILENT_WINDOW_DATABASE_URL=mysql+pymysql://YOUR_APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/silent_window?charset=utf8mb4
# Optional isolated integration-test database. Never point this at the real database.
# SILENT_WINDOW_TEST_DATABASE_URL=mysql+pymysql://YOUR_TEST_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/silent_window_auth_test?charset=utf8mb4
